{
  "expo": {
    "name": "RuoYi AI Quick Starter",
    "slug": "ruoyi-rn-app",
    "version": "4.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ruoyi.rn"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#67C23A"
      },
      "package": "com.ruoyi.rn"
    },
    "web": {},
    "scheme": "ruoyi-rn-app",
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#67C23A",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
